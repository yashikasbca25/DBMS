LAB-4

CREATE DATABASE IF NOT EXISTS dbmslab;
USE dbmslab;
DROP TABLE IF EXISTS STUDENT;
CREATE TABLE STUDENT (
    ID INT,
    NAME VARCHAR(30),
    MARKS INT,
    DOB DATE
);
INSERT INTO STUDENT VALUES
(1, 'Rahul', 85, '2005-05-10'),
(2, 'Ananya', 92, '2004-08-15'),
(3, 'Rohan', 76, '2005-01-20');
SELECT
    ID,
    NAME,
    MARKS,
    DOB,
    CAST(MARKS AS CHAR) AS Marks_Text,
    CONVERT(MARKS, CHAR) AS Convert_Text,
    CAST(DOB AS CHAR) AS DOB_Text,
    CURRENT_DATE AS Today_Date,
    CURRENT_TIMESTAMP AS Current_Date_Time,
    YEAR(DOB) AS Birth_Year,
    MONTH(DOB) AS Birth_Month,
    DAY(DOB) AS Birth_Day,
    DATE_ADD(DOB, INTERVAL 1 YEAR) AS Date_After_1_Year,
    DATEDIFF(CURRENT_DATE, DOB) AS Days_Difference
FROM STUDENT;
