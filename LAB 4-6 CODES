SPECIAL OPERATORS:

CREATE DATABASE IF NOT EXISTS dbmslab;
USE dbmslab;
DROP TABLE IF EXISTS STUDENT;
CREATE TABLE STUDENT (
    ID INT,
    NAME VARCHAR(30),
    MARKS INT,
    DOB DATE
);
INSERT INTO STUDENT VALUES
(1, 'Rahul', 85, '2005-05-10'),
(2, 'Ananya', 92, '2004-08-15'),
(3, 'Rohan', 76, '2005-01-20'),
(4, 'Priya', 88, '2004-12-05'),
(5, 'Karan', 65, '2005-07-25');
SELECT
    ID,
    NAME,
    MARKS,
    MARKS BETWEEN 80 AND 90 AS Between_80_90,
    MARKS IN (76, 85, 92) AS In_Example,
    MARKS NOT IN (76, 85) AS Not_In_Example,
    NAME LIKE 'R%' AS Like_Example,
    DOB IS NULL AS Is_Null,
    DOB IS NOT NULL AS Is_Not_Null
FROM STUDENT;

