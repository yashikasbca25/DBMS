LAB-5

CREATE DATABASE IF NOT EXISTS dbmslab;
USE dbmslab;
DROP TABLE IF EXISTS STUDENT;
CREATE TABLE STUDENT (
    ID INT,
    NAME VARCHAR(30),
    MARKS INT,
    DOB DATE
);
INSERT INTO STUDENT VALUES
(1, 'Rahul', 85, '2005-05-10'),
(2, 'Ananya', 92, '2004-08-15'),
(3, 'Rohan', 76, '2005-01-20'),
(4, 'Priya', 88, '2004-12-05'),
(5, 'Karan', 65, '2005-07-25');
SELECT
    ID,
    NAME,
    MARKS,
    MARKS + 5 AS Addition,
    MARKS - 5 AS Subtraction,
    MARKS * 2 AS Multiplication,
    MARKS / 2 AS Division,
    MOD(MARKS, 10) AS Remainder,
    MARKS = 85 AS Equal_85,
    MARKS <> 85 AS Not_Equal_85,
    MARKS > 80 AS Greater_Than_80,
    MARKS < 80 AS Less_Than_80,
    MARKS >= 85 AS Greater_Equal_85,
    MARKS <= 85 AS Less_Equal_85,
    (MARKS > 80 AND MARKS < 95) AS AND_Example,
    (MARKS > 90 OR MARKS < 80) AS OR_Example,
    (NOT MARKS = 85) AS NOT_Example
FROM STUDENT;
