CREATE DATABASE db3;
USE db3;
CREATE TABLE Employee (
    emp_id INT PRIMARY KEY,
    emp_name VARCHAR(30),
    salary INT
);
CREATE TABLE AuditLog (
    action_type VARCHAR(20),
    emp_id INT,
    message VARCHAR(100)
);
INSERT INTO Employee VALUES
(101, 'Amit', 30000),
(102, 'Priya', 45000);
DELIMITER //
CREATE TRIGGER before_emp_insert
BEFORE INSERT ON Employee
FOR EACH ROW
BEGIN
    IF NEW.salary <= 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Salary must be positive';
    END IF;
END //
CREATE TRIGGER after_emp_insert
AFTER INSERT ON Employee
FOR EACH ROW
BEGIN
    INSERT INTO AuditLog VALUES
    ('INSERT', NEW.emp_id, 'Employee inserted');
END //
CREATE TRIGGER before_emp_update
BEFORE UPDATE ON Employee
FOR EACH ROW
BEGIN
    IF NEW.salary <= 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Salary must be positive';
    END IF;
END //
CREATE TRIGGER after_emp_update
AFTER UPDATE ON Employee
FOR EACH ROW
BEGIN
    INSERT INTO AuditLog VALUES
    ('UPDATE', NEW.emp_id, 'Employee updated');
END //
CREATE TRIGGER before_emp_delete
BEFORE DELETE ON Employee
FOR EACH ROW
BEGIN
    IF OLD.salary > 60000 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Cannot delete salary above 60000';
    END IF;
END //
CREATE TRIGGER after_emp_delete
AFTER DELETE ON Employee
FOR EACH ROW
BEGIN
    INSERT INTO AuditLog VALUES
    ('DELETE', OLD.emp_id, 'Employee deleted');
END //
DELIMITER ;
INSERT INTO Employee VALUES
(103, 'Rahul', 35000);
UPDATE Employee
SET salary = 50000
WHERE emp_id = 102;
DELETE FROM Employee
WHERE emp_id = 101;
SELECT * FROM Employee;
SELECT * FROM AuditLog;
