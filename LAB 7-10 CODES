CREATE DATABASE db2;
USE db2;
CREATE TABLE Employee (
    emp_id INT PRIMARY KEY,
    emp_name VARCHAR(30),
    salary INT
);
INSERT INTO Employee VALUES
(101, 'Amit', 30000),
(102, 'Priya', 45000),
(103, 'Rahul', 35000);
DELIMITER //
CREATE PROCEDURE ShowEmployees()
BEGIN
    SELECT * FROM Employee;
END //
CREATE PROCEDURE InsertEmployee(
    IN p_id INT,
    IN p_name VARCHAR(30),
    IN p_salary INT
)
BEGIN
    INSERT INTO Employee
    VALUES (p_id, p_name, p_salary);
END //
CREATE PROCEDURE UpdateEmployee(
    IN p_id INT,
    IN p_salary INT
)
BEGIN
    UPDATE Employee
    SET salary = p_salary
    WHERE emp_id = p_id;
END //
CREATE PROCEDURE DeleteEmployee(IN p_id INT)
BEGIN
    DELETE FROM Employee
    WHERE emp_id = p_id;
END //
DELIMITER ;
CALL ShowEmployees();
CALL InsertEmployee(104, 'Neha', 25000);
SELECT * FROM Employee;
CALL UpdateEmployee(102, 50000);
SELECT * FROM Employee;
CALL DeleteEmployee(103);
SELECT * FROM Employee;
